# The WROOM board with the ZED-F9P. Read after sdkconfig.defaults when the
# target is esp32, so only what differs from the C3 is here; the receiver, the
# pins and the hostname follow the target in main/Kconfig.projbuild.

# BLE only. The ESP32 has Bluetooth Classic, but nothing here uses it, and the
# dual-mode controller holds on to memory WiFi wants.
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BTDM_CTRL_MODE_BTDM=n
# Modem sleep, for the magnetometer's sake as on the C3 (see magnetometer.c),
# clocked from the main crystal: DevKit boards have no 32 kHz one.
CONFIG_BTDM_CTRL_MODEM_SLEEP=y
CONFIG_BTDM_CTRL_MODEM_SLEEP_MODE_ORIG=y
CONFIG_BTDM_CTRL_LPCLK_SEL_MAIN_XTAL=y
