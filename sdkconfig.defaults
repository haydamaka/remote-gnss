CONFIG_IDF_TARGET="esp32c3"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# BLE for the Nordic UART Service in nmea_ble.c. NimBLE rather than Bluedroid:
# this is a peripheral only, and NimBLE costs far less flash. It is also why
# the two-slot partition table above is not optional: the image outgrows the
# 1 MB app partition of the default single-app table.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247

# Several NMEA clients at once plus the web server exhausted lwip's send
# buffers, which stalled every socket together. Each client is a ~2 KB/s
# trickle, so a smaller buffer per socket costs nothing and leaves room.
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=2880
CONFIG_LWIP_TCP_WND_DEFAULT=2880

# BLE and WiFi together leave very little heap on a C3, and the BLE controller
# refused to start. Trim both: one connection, no pairing (the NMEA stream is
# not a secret), fewer WiFi buffers, and the WiFi IRAM optimisations off, which
# on this chip returns that memory to the heap.
CONFIG_BT_NIMBLE_SM_LEGACY=n
CONFIG_BT_NIMBLE_SM_SC=n
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=3072
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
# Bluetooth modem sleep: the controller powers the radio down between radio
# events. Without it the radio is on for as long as BLE runs, the magnetometer
# never gets a read taken with it off, and every sample is thrown away (see
# magnetometer.c). The main crystal is the sleep clock: this board has no 32 kHz one.
CONFIG_BT_CTRL_MODEM_SLEEP=y
CONFIG_BT_CTRL_MODEM_SLEEP_MODE_1=y
CONFIG_BT_CTRL_LPCLK_SEL_MAIN_XTAL=y
